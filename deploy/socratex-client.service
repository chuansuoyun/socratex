[Unit]
Description=Socratex Local Client (SOCKS5/HTTP tunnel)
Documentation=https://github.com/chuansuoyun/socratex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
WorkingDirectory=/opt/socratex
ExecStart=/opt/socratex/socratex -config /opt/socratex/config.client.json
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
